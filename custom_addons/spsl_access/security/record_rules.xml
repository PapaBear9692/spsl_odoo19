<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!--
        TASK 3.6.6 — Branch isolation record rules.

        Confirmed operating_unit_id field presence (via ir_model_fields):
          sale.order    → YES (operating_unit_id)
          account.move  → YES (operating_unit_id)
          purchase.order → NO  (operating_unit module not extended to PO in this build)

        purchase.order rule is commented out until the OU field is added.
    -->

    <!-- ── sale.order write/create restriction for branch roles ── -->
    <record id="rule_sale_order_branch_write" model="ir.rule">
        <field name="name">SPSL: Sale Order branch write isolation</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[
            Command.link(ref('spsl_access.group_sales_manager')),
            Command.link(ref('spsl_access.group_sales_representative')),
            Command.link(ref('spsl_access.group_branch_manager')),
            Command.link(ref('spsl_access.group_mps_coordinator')),
        ]"/>
        <field name="domain_force">
            ['|', ('operating_unit_id', '=', False),
                  ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ── account.move write/create for branch accountant ── -->
    <record id="rule_account_move_branch_write" model="ir.rule">
        <field name="name">SPSL: Account Move branch write isolation</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="groups" eval="[
            Command.link(ref('spsl_access.group_accountant_branch')),
            Command.link(ref('spsl_access.group_branch_manager')),
        ]"/>
        <field name="domain_force">
            ['|', ('operating_unit_id', '=', False),
                  ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--
        purchase.order branch isolation — operating_unit_id not present on
        purchase.order in this build. The operating_unit_purchase (or similar)
        community module needs to be installed to extend PO with OU field.
        Uncomment once that module is installed.

    <record id="rule_purchase_order_branch_write" model="ir.rule">
        <field name="name">SPSL: Purchase Order branch write isolation</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[
            Command.link(ref('spsl_access.group_purchase_officer')),
            Command.link(ref('spsl_access.group_branch_manager')),
        ]"/>
        <field name="domain_force">
            ['|', ('operating_unit_id', '=', False),
                  ('operating_unit_id', 'in', user.operating_unit_ids.ids)]
        </field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    -->

    <!-- ── Auditor: read-only enforcement ── -->
    <record id="rule_auditor_sale_readonly" model="ir.rule">
        <field name="name">SPSL: Auditor read-only sale.order</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[Command.link(ref('spsl_access.group_auditor'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>

    <!-- ============================================================
         GROUP INHERITANCE HIERARCHY (SPSL group → SPSL group)
         Added AFTER all groups are defined so forward-references
         resolve correctly.
    ============================================================ -->

    <!-- Finance: CFO → Finance Manager (HQ) → Accountant (HQ) -->
    <record id="group_cfo" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('spsl_access.group_finance_manager_hq')),
        ]"/>
    </record>

    <record id="group_finance_manager_hq" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('spsl_access.group_accountant_hq')),
        ]"/>
    </record>

    <!-- Sales: Sales Director → Sales Manager → Sales Representative -->
    <record id="group_sales_director" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('spsl_access.group_sales_manager')),
        ]"/>
    </record>

    <record id="group_sales_manager" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('spsl_access.group_sales_representative')),
        ]"/>
    </record>

    <!-- Field Service: Field Supervisor → Field Engineer -->
    <record id="group_field_supervisor" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('spsl_access.group_field_engineer')),
        ]"/>
    </record>

    <!-- HR: HR Manager → Payroll Officer + Payroll Manager + Leave Manager -->
    <record id="group_hr_manager" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('spsl_access.group_payroll_officer')),
            Command.link(ref('hr_payroll_community.group_hr_payroll_community_manager')),
            Command.link(ref('hr_holidays.group_hr_holidays_manager')),
        ]"/>
    </record>

    <!-- Payroll Officer → Payroll Community User -->
    <record id="group_payroll_officer" model="res.groups">
        <field name="implied_ids" eval="[
            Command.link(ref('hr_payroll_community.group_hr_payroll_community_user')),
        ]"/>
    </record>

</data>

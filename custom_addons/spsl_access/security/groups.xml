<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="0">

    <!--
        SPSL Access Control — 25 Role Groups
        Odoo 19 CE: res.groups has no category_id field.
        Groups are prefixed "SPSL / " so they appear grouped by
        the slash convention in Settings > Users & Companies > Groups.
    -->

    <!-- ============================================================
         TASK 3.6.1 — EXECUTIVE AND FINANCE (8 groups)
    ============================================================ -->

    <record id="group_system_administrator" model="res.groups">
        <field name="name">SPSL / System Administrator</field>
        <field name="sequence">1</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_system')),
            Command.link(ref('account.group_account_manager')),
            Command.link(ref('sales_team.group_sale_manager')),
            Command.link(ref('purchase.group_purchase_manager')),
            Command.link(ref('stock.group_stock_manager')),
            Command.link(ref('hr.group_hr_manager')),
            Command.link(ref('operating_unit_access_all.group_all_operating_unit')),
        ]"/>
    </record>

    <record id="group_managing_director" model="res.groups">
        <field name="name">SPSL / Managing Director</field>
        <field name="sequence">2</field>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('account.group_account_user')),
            Command.link(ref('sales_team.group_sale_salesman')),
            Command.link(ref('operating_unit_access_all.group_all_operating_unit')),

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Test Notification Template -->
        <record id="notification_template_test" model="spsl.notification.template">
            <field name="event_code">NE-TEST-001</field>
            <field name="name">Test Notification</field>
            <field name="description">Test notification for debugging notification pipeline</field>
            <field name="recipient_type">specific_user</field>
            <field name="subject_template">Test Notification: {{object.name}}</field>
            <field name="body_template"><![CDATA[<p>Hello {{object.name}},</p><p>This is a test notification.</p>]]></field>
            <field name="is_mandatory">True</field>
            <field name="active">True</field>
            <field name="channels" eval="[(4, ref('spsl_core.channel_in_app')), (4, ref('spsl_core.channel_email'))]"/>
            <field name="recipient_user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Approval Request Notification -->
        <record id="notification_template_approval_request" model="spsl.notification.template">
            <field name="event_code">NE-APPROVAL-001</field>
            <field name="name">Approval Request</field>
            <field name="description">Notification when an approval request is submitted</field>
            <field name="recipient_type">role_group</field>
            <field name="subject_template">Approval Request: {{object.name}}</field>
            <field name="body_template"><![CDATA[<p>New approval request:</p><ul><li><strong>Document:</strong> {{object.name or ''}}</li><li><strong>Requested By:</strong> {{object.requested_by.name or ''}}</li></ul>]]></field>
            <field name="is_mandatory">True</field>
            <field name="active">True</field>
            <field name="channels" eval="[(4, ref('spsl_core.channel_in_app')), (4, ref('spsl_core.channel_email'))]"/>
        </record>

        <!-- Approval Approved Notification -->
        <record id="notification_template_approval_approved" model="spsl.notification.template">
            <field name="event_code">NE-APPROVAL-002</field>
            <field name="name">Approval Approved</field>
            <field name="description">Notification when an approval request is approved</field>
            <field name="recipient_type">specific_user</field>
            <field name="subject_template">Approved: {{object.name}}</field>
            <field name="body_template"><![CDATA[<p>Your approval request has been approved:</p><ul><li><strong>Document:</strong> {{object.name or ''}}</li><li><strong>Approved By:</strong> {{object.approved_by.name or ''}}</li></ul>]]></field>
            <field name="is_mandatory">True</field>
            <field name="active">True</field>
            <field name="channels" eval="[(4, ref('spsl_core.channel_in_app')), (4, ref('spsl_core.channel_email'))]"/>
        </record>

        <!-- Approval Rejected Notification -->
        <record id="notification_template_approval_rejected" model="spsl.notification.template">
            <field name="event_code">NE-APPROVAL-003</field>
            <field name="name">Approval Rejected</field>
            <field name="description">Notification when an approval request is rejected</field>
            <field name="recipient_type">specific_user</field>
            <field name="subject_template">Rejected: {{object.name}}</field>
            <field name="body_template"><![CDATA[<p>Your approval request has been rejected:</p><ul><li><strong>Document:</strong> {{object.name or ''}}</li><li><strong>Rejected By:</strong> {{object.rejected_by.name or ''}}</li><li><strong>Reason:</strong> {{object.rejection_reason or ''}}</li></ul>]]></field>
            <field name="is_mandatory">False</field>
            <field name="active">True</field>
            <field name="channels" eval="[(4, ref('spsl_core.channel_in_app')), (4, ref('spsl_core.channel_email'))]"/>
        </record>
    </data>
</odoo>
    <record id="event_approval_submit" model="spsl.notification.event">
        <field name="name">Approval Submitted</field>
        <field name="code">approval.submit</field>
        <field name="category">approval</field>
    </record>
    <record id="event_approval_approved" model="spsl.notification.event">

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Notification Channels -->
        <record id="channel_in_app" model="spsl.notification.channel">
            <field name="name">In-App Notification</field>
            <field name="code">in_app</field>
            <field name="active">True</field>
            <field name="description">Notifications displayed within the Odoo interface.</field>
        </record>

        <record id="channel_email" model="spsl.notification.channel">
            <field name="name">Email</field>
            <field name="code">email</field>
            <field name="active">True</field>
            <field name="description">Notifications sent via email.</field>
        </record>

        <record id="channel_sms" model="spsl.notification.channel">
            <field name="name">SMS</field>
            <field name="code">sms</field>
            <field name="active">True</field>
            <field name="description">Notifications sent via SMS.</field>
        </record>

        <record id="channel_push" model="spsl.notification.channel">
            <field name="name">Push Notification</field>
            <field name="code">push</field>
            <field name="active">True</field>
            <field name="description">Push notifications for mobile devices.</field>
        </record>
    </data>
</odoo>
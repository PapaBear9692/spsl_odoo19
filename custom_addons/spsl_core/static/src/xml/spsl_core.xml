<templates xml:space="preserve">

    <!-- ApprovalStatusBadge — field widget -->
    <t t-name="spsl_core.ApprovalStatusBadge">
        <div class="spsl-approval-badge-widget">
            <span t-attf-class="spsl-badge {{badgeClass}}">
                <t t-esc="stateLabel"/>
            </span>
            <t t-if="showMeta">
                <div class="spsl-approval-meta">
                    <span class="spsl-meta-user" t-esc="metaUser"/>
                    <span t-if="metaDate" class="spsl-meta-sep"> — </span>
                    <span class="spsl-meta-date" t-esc="metaDate"/>
                </div>
            </t>
        </div>
    </t>

</templates>

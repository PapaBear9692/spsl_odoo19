<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- ir.rule — spsl.audit.log access control -->
    <!-- ============================================================ -->
    <!-- Rule 1: Audit Viewer group can READ audit logs -->
    <!-- All other operations (write, unlink) are blocked by the model -->
    <!-- ============================================================ -->
    <record id="audit_log_rule_audit_viewer" model="ir.rule">
        <field name="name">Audit Log: viewer can read</field>
        <field name="model_id" ref="model_spsl_audit_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('spsl_core.group_spsl_audit_viewer'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- ir.rule — spsl.audit.log.archive access control -->
    <!-- ============================================================ -->
    <!-- Archive table also restricted to Audit Viewer group -->
    <!-- ============================================================ -->
    <record id="audit_log_archive_rule_audit_viewer" model="ir.rule">
        <field name="name">Audit Log Archive: viewer can read</field>
        <field name="model_id" ref="model_spsl_audit_log_archive"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('spsl_core.group_spsl_audit_viewer'))]"/>
    </record>

    <!-- ============================================================ -->
    <!-- ir.rule — spsl.audit.config access control -->
    <!-- ============================================================ -->
    <!-- Audit Configuration: only Audit Viewer group can manage -->
    <!-- ============================================================ -->
    <record id="audit_config_rule_audit_viewer" model="ir.rule">
        <field name="name">Audit Config: viewer can read</field>
        <field name="model_id" ref="model_spsl_audit_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('spsl_core.group_spsl_audit_viewer'))]"/>
    </record>
</odoo>
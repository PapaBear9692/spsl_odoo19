<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Notification Log: Tree View (with status color coding)        -->
    <!-- ============================================================ -->
    <record id="view_spsl_notification_log_list" model="ir.ui.view">
        <field name="name">spsl.notification.log.list</field>
        <field name="model">spsl.notification.log</field>
        <field name="arch" type="xml">
            <list string="Notification Logs" default_order="id desc"
                  decoration-success="status in ('sent', 'delivered')"
                  decoration-danger="status in ('failed', 'bounced')"
                  decoration-warning="status == 'queued'">
                <field name="event_code"/>
                <field name="channel"/>
                <field name="recipient_id"/>
                <field name="recipient_email"/>
                <field name="sent_date"/>
                <field name="status" widget="badge"/>
                <field name="retry_count"/>
                <field name="template_id"/>
                <field name="document_ref"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Notification Log: Form View                                   -->
    <!-- ============================================================ -->
    <record id="view_spsl_notification_log_form" model="ir.ui.view">
        <field name="name">spsl.notification.log.form</field>
        <field name="model">spsl.notification.log</field>
        <field name="arch" type="xml">
            <form string="Notification Log" create="0" edit="0" delete="0">
                <sheet>
                    <group string="Details">
                        <group>
                            <field name="event_code"/>
                            <field name="template_id"/>
                            <field name="channel"/>
                            <field name="status" widget="badge"/>
                            <field name="sent_date"/>
                        </group>
                        <group>
                            <field name="recipient_id"/>
                            <field name="recipient_email"/>
                            <field name="recipient_phone"/>
                            <field name="document_ref"/>
                        </group>
                    </group>
                    <group string="Retry Information">
                        <field name="retry_count"/>
                        <field name="next_retry_date"/>
                    </group>
                    <group string="Error Details" invisible="not error_message">
                        <field name="error_message" colspan="2" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Notification Log: Search View                                 -->
    <!-- ============================================================ -->
    <record id="view_spsl_notification_log_search" model="ir.ui.view">
        <field name="name">spsl.notification.log.search</field>
        <field name="model">spsl.notification.log</field>
        <field name="arch" type="xml">
            <search string="Search Notification Logs">
                <field name="event_code"/>
                <field name="recipient_id"/>
                <field name="recipient_email"/>
                <field name="channel"/>
                <field name="status"/>
                <field name="template_id"/>
                <separator/>
                <filter name="filter_failed" string="Failed"
                        domain="[('status', '=', 'failed')]"/>
                <filter name="filter_queued" string="Queued"
                        domain="[('status', '=', 'queued')]"/>
                <filter name="filter_sent" string="Sent"
                        domain="[('status', 'in', ['sent', 'delivered'])]"/>
                <filter name="filter_sent_today" string="Sent Today"
                        domain="[('sent_date', '>=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_needs_retry" string="Needs Retry"
                        domain="[('status', '=', 'failed'), ('retry_count', '&lt;', 3)]"/>
                <separator/>
                <filter name="groupby_channel" string="Channel"
                        context="{'group_by': 'channel'}"/>
                <filter name="groupby_status" string="Status"
                        context="{'group_by': 'status'}"/>
                <filter name="groupby_event_code" string="Event Code"
                        context="{'group_by': 'event_code'}"/>
                <filter name="groupby_recipient" string="Recipient"
                        context="{'group_by': 'recipient_id'}"/>
                <filter name="groupby_sent_date" string="Sent Date"
                        context="{'group_by': 'sent_date:day'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- Notification Log: Action                                      -->
    <!-- ============================================================ -->
    <record id="action_spsl_notification_log" model="ir.actions.act_window">
        <field name="name">Notification Logs</field>
        <field name="res_model">spsl.notification.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_sent_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No notification logs found.
            </p>
            <p>
                Notification logs are created automatically when notifications
                are dispatched. Check back after triggering a notification event.
            </p>
        </field>
    </record>

</odoo>

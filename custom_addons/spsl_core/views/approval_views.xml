<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    # Approval Rule Views
    <!-- ============================================================ -->

    <!-- Approval Rule: Tree View -->
    <record id="view_spsl_approval_rule_tree" model="ir.ui.view">
        <field name="name">spsl.approval.rule.tree</field>
        <field name="model">spsl.approval.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_name"/>
                <field name="field_trigger"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Approval Rule: Form View -->
    <record id="view_spsl_approval_rule_form" model="ir.ui.view">
        <field name="name">spsl.approval.rule.form</field>
        <field name="model">spsl.approval.rule</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- No workflow buttons for rules — they are config records -->
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-check-circle"
                                name="action_archive" type="object"
                                invisible="active == False">
                            <field name="active" widget="boolean_button" options='{"terminology": "active"}'/>
                        </button>
                        <button class="oe_stat_button" icon="fa-check-circle"
                                name="action_unarchive" type="object"
                                invisible="active == True">
                            <field name="active" widget="boolean_button" options='{"terminology": "active"}'/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Rule Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name"/>
                            <field name="field_trigger" placeholder="e.g. amount_total"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Approval Tiers" name="tiers">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="amount_from"/>
                                    <field name="amount_to"/>
                                    <field name="approver_group_id"/>
                                    <field name="approver_user_id"/>
                                    <field name="require_all"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Approval Rule: Search View -->
    <record id="view_spsl_approval_rule_search" model="ir.ui.view">
        <field name="name">spsl.approval.rule.search</field>
        <field name="model">spsl.approval.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_name"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Approval Rule: Action -->
    <record id="action_spsl_approval_rule" model="ir.actions.act_window">
        <field name="name">Approval Rules</field>
        <field name="res_model">spsl.approval.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define approval rules for documents
            </p>
            <p>
                Approval rules determine which documents require approval
                and what thresholds trigger each approval tier.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    # Approval Request Views
    <!-- ============================================================ -->

    <!-- Approval Request: Tree View -->
    <record id="view_spsl_approval_request_tree" model="ir.ui.view">
        <field name="name">spsl.approval.request.tree</field>
        <field name="model">spsl.approval.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="document_ref"/>
                <field name="state"/>
                <field name="requested_by"/>
                <field name="requested_date"/>
                <field name="approved_by"/>
                <field name="escalated"/>
            </list>
        </field>
    </record>

    <!-- Approval Request: Form View -->
    <record id="view_spsl_approval_request_form" model="ir.ui.view">
        <field name="name">spsl.approval.request.form</field>
        <field name="model">spsl.approval.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-success"
                            invisible="state != 'pending'"/>
                    <button name="action_reject" string="Reject" type="object"
                            class="btn-danger"
                            invisible="state != 'pending'"/>
                    <button name="action_escalate" string="Escalate" type="object"
                            class="btn-warning"
                            invisible="state != 'pending'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div style="margin-bottom: 12px;">
                        <field name="state" widget="approval_status_badge" nolabel="1"/>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="document_ref"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="res_name"/>
                        </group>
                        <group string="Rule">
                            <field name="rule_id"/>
                            <field name="rule_line_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Request">
                            <field name="requested_by"/>
                            <field name="requested_date"/>
                        </group>
                        <group string="Approval">
                            <field name="approved_by"/>
                            <field name="approved_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Rejection">
                            <field name="rejected_by"/>
                            <field name="rejected_date"/>
                            <field name="rejection_reason"/>
                        </group>
                        <group string="Escalation">
                            <field name="escalated"/>
                            <field name="escalation_date"
                                   invisible="not escalated"/>
                        </group>
                    </group>
                    <group>
                        <group string="Reminders">
                            <field name="reminder_count"/>
                            <field name="last_reminder_date"/>
                        </group>
                        <group string="Deputy Approver">
                            <field name="deputy_approver_id"/>
                        </group>
                    </group>
                    <group string="Comments">
                        <field name="comments" nolabel="1" colspan="2" placeholder="Add comments..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Approval Request: Search View -->
    <record id="view_spsl_approval_request_search" model="ir.ui.view">
        <field name="name">spsl.approval.request.search</field>
        <field name="model">spsl.approval.request</field>
        <field name="arch" type="xml">
            <search string="Search Approval Requests">
                <field name="name"/>
                <field name="document_ref"/>
                <field name="requested_by"/>
                <separator/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter name="filter_my_requests" string="My Requests" domain="[('requested_by', '=', uid)]"/>
                <filter name="filter_escalated" string="Escalated" domain="[('escalated', '=', True)]"/>
                <separator/>
                <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                <filter name="group_requested_by" string="Requested By" context="{'group_by': 'requested_by'}"/>
            </search>
        </field>
    </record>

    <!-- Approval Request: Action -->
    <record id="action_spsl_approval_request" model="ir.actions.act_window">
        <field name="name">Approval Requests</field>
        <field name="res_model">spsl.approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval requests found
            </p>
            <p>
                Approval requests are created automatically when a document
                is submitted for approval.
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    # Menu Items
    <!-- ============================================================ -->

    <!-- Top-level SPSL Core menu -->
    <menuitem id="menu_spsl_core_root"
              name="SPSL Core"
              sequence="40"/>

    <!-- Approvals submenu -->
    <menuitem id="menu_spsl_approvals"
              name="Approvals"
              parent="menu_spsl_core_root"
              sequence="10"/>

    <menuitem id="menu_spsl_approval_rule"
              name="Approval Rules"
              action="action_spsl_approval_rule"
              parent="menu_spsl_approvals"
              sequence="10"
              groups="spsl_core.group_spsl_approval_manager"/>

    <menuitem id="menu_spsl_approval_request"
              name="Approval Requests"
              action="action_spsl_approval_request"
              parent="menu_spsl_approvals"
              sequence="20"/>

    <!-- ============================================================ -->
    # Deputy Approver Views
    <!-- ============================================================ -->

    <!-- Deputy Approver: Tree View -->
    <record id="view_spsl_approval_deputy_tree" model="ir.ui.view">
        <field name="name">spsl.approval.deputy.tree</field>
        <field name="model">spsl.approval.deputy</field>
        <field name="arch" type="xml">
            <list decoration-success="active" decoration-muted="not active">
                <field name="user_id"/>
                <field name="deputy_user_id"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Deputy Approver: Form View -->
    <record id="view_spsl_approval_deputy_form" model="ir.ui.view">
        <field name="name">spsl.approval.deputy.form</field>
        <field name="model">spsl.approval.deputy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="user_id"/>
                            <field name="deputy_user_id"/>
                        </group>
                        <group>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Deputy Approver: Search View -->
    <record id="view_spsl_approval_deputy_search" model="ir.ui.view">
        <field name="name">spsl.approval.deputy.search</field>
        <field name="model">spsl.approval.deputy</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="deputy_user_id"/>
                <separator/>
                <filter name="filter_active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_user" string="Absent Approver" context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <!-- Deputy Approver: Action -->
    <record id="action_spsl_approval_deputy" model="ir.actions.act_window">
        <field name="name">Deputy Approvers</field>
        <field name="res_model">spsl.approval.deputy</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No deputy approvers configured
            </p>
            <p>
                Define deputy approvers to handle approvals when the
                primary approver is unavailable (on leave, traveling, etc.).
                Deputy assignments are date-ranged and automatic.
            </p>
        </field>
    </record>

    <!-- Deputy Approver: Menu Item -->
    <menuitem id="menu_spsl_approval_deputy"
              name="Deputy Approvers"
              action="action_spsl_approval_deputy"
              parent="menu_spsl_approvals"
              sequence="15"
              groups="spsl_core.group_spsl_approval_manager"/>
</odoo>
